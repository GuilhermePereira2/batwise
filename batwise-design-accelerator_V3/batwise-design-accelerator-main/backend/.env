# Backend API Configuration
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=your_email@example.com
MAIL_SERVER=smtp.zoho.eu
MAIL_PORT=587

# DynamoDB Configuration
# Para desenvolvimento local com DynamoDB Local, descomente:
# DYNAMODB_ENDPOINT=http://localhost:8000

# Para AWS DynamoDB (produção):
AWS_REGION=eu-west-3
USERS_TABLE_NAME=watt-builder-Users

# AWS Credentials (necessário para AWS DynamoDB)
# Se usar IAM roles (Lambda, EC2), não precisa definir isto
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# JWT Security
# IMPORTANTE: Mudar em produção! Gerar com: openssl rand -hex 32
