# ========================================
# Configuração Offline (Desenvolvimento Local)
# ========================================
# 
# 4 Cenários Possíveis:
# 1) Tudo Local: Frontend local + Backend local + Database local
# 2) Backend local + Database online: Frontend local + Backend local + Database AWS
# 3) Frontend local + Backend/DB online: Frontend local + Backend/DB AWS
# 4) Tudo Online: Push para GitHub e deploy automático (Vercel + AWS)
#
# =======================================

# === BACKEND & DATABASE ===
# Backend Port (para desenvolvimento local)
BACKEND_PORT=8001

# Para Database LOCAL (DynamoDB Local)
DYNAMODB_ENDPOINT=http://localhost:8000

# Para Database ONLINE (AWS), deixar vazio:
DYNAMODB_ENDPOINT=

# AWS Configuration (só needed se usar DB online)
AWS_REGION=eu-west-3
# Perfil AWS local usado pelo boto3 quando o backend corre na tua máquina.
# Este perfil tem de ter credenciais SDK válidas, SSO suportado pelo boto3,
# ou aws login com boto3>=1.41.0 e awscrt instalado.
# Confirma com: aws sts get-caller-identity --profile duarte
AWS_PROFILE=duarte
USERS_TABLE_NAME=watt-builder-Users
SIMULATION_INPUTS_TABLE_NAME=watt-builder-SimulationInputs

# Email Configuration
MAIL_FROM=noreply@watt-builder.com 
MAIL_USERNAME=noreply@watt-builder.com
MAIL_PASSWORD=JZUuSWYuYN0N
MAIL_PORT=587  # Zoho
MAIL_SERVER=smtp.zoho.eu

FRONTEND_URL=http://localhost:5173 # URL do frontend para callbacks (ex: links de reset de senha) Muder 
# Quando fizeres deploy, mudas para https://www.watt-builder.com

# JWT Secret (CRÍTICO em produção!)
# Usado para assinar tokens de login/autenticação
# Para gerar uma chave segura: openssl rand -hex 32
# NUNCA commitar a chave real para Git!
# Se mudar em produção, todos os users precisam fazer login novamente
SECRET_KEY=ee9a07c9aafa4016d44015f498d64e4e68652799c22f194749466617e78da18c

# === FRONTEND ===
# Para Backend LOCAL (Cenário 1 e 2)
VITE_API_URL=http://localhost:8001
VITE_GOOGLE_CLIENT_ID=279039887448-68tk5eahn48u3jj4mh2i5215u4ej02j9.apps.googleusercontent.com

# Para Backend ONLINE (Cenário 3)
VITE_API_URL=https://72upm2kd45l3ersqojz5boxydu0twcvx.lambda-url.eu-west-3.on.aws/
